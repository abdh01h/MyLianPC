<UserControl x:Class="MyLianPC.App.Views.LcdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MyLianPC.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Cooler LCD" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Design what the HydroShift II screen shows. The preview uses your live sensor readings; nothing is sent to the cooler until you click Apply."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Show" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeTheme" Content="Theme" GroupName="mode" Checked="Mode_Checked" Margin="0,0,16,0" />
                                <RadioButton x:Name="ModeImage" Content="Image" GroupName="mode" Checked="Mode_Checked" Margin="0,0,16,0" />
                                <RadioButton x:Name="ModeAnimation" Content="GIF animation" GroupName="mode" Checked="Mode_Checked" Margin="0,0,16,0" />
                                <RadioButton x:Name="ModeOff" Content="Screen off" GroupName="mode" Checked="Mode_Checked" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" x:Name="ThemeCard">
                        <StackPanel>
                            <TextBlock Text="Themes" Style="{StaticResource SectionTitle}" />
                            <ListBox x:Name="ThemeList" SelectionChanged="Theme_Changed" BorderThickness="0" Background="Transparent"
                                     PreviewMouseWheel="List_PreviewMouseWheel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="126" Margin="2,4">
                                            <Image Source="{Binding Thumb}" Width="110" Height="110" />
                                            <TextBlock Text="{Binding Theme.Name}" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" x:Name="MediaCard">
                        <StackPanel>
                            <TextBlock Text="Image or animation" Style="{StaticResource SectionTitle}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Choose file…" Click="ChooseMedia_Click" />
                                <TextBlock x:Name="MediaName" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="OverlayBox" Content="Show clock and temperatures over the image" Margin="0,10,0,0" Click="Option_Changed" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="PNG, JPEG, BMP, WebP or GIF up to 25 MB. Pictures are cropped to fill the round 480×480 panel; GIFs play at up to 15 frames per second." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" x:Name="StyleCard">
                        <StackPanel>
                            <TextBlock Text="Style" Style="{StaticResource SectionTitle}" />
                            <WrapPanel>
                                <Button x:Name="BgButton" Content="Background" Click="ColorButton_Click" Tag="bg" Margin="0,0,8,8" />
                                <Button x:Name="TextButton" Content="Text" Click="ColorButton_Click" Tag="text" Margin="0,0,8,8" />
                                <Button x:Name="AccentButton" Content="Accent" Click="ColorButton_Click" Tag="accent" Margin="0,0,8,8" />
                                <Button x:Name="SecondButton" Content="Secondary" Click="ColorButton_Click" Tag="second" Margin="0,0,8,8" />
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Font" VerticalAlignment="Center" />
                                <ComboBox x:Name="FontBox" Grid.Column="1" SelectionChanged="Option_Changed" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="Text size" VerticalAlignment="Center" />
                                <Slider x:Name="FontScale" Grid.Row="1" Grid.Column="1" Minimum="0.5" Maximum="2" ValueChanged="Option_Changed" Margin="0,4" />
                                <TextBlock Grid.Row="2" Text="Temperature" VerticalAlignment="Center" />
                                <ComboBox x:Name="UnitBox" Grid.Row="2" Grid.Column="1" SelectionChanged="Option_Changed" Margin="0,4" />
                                <TextBlock Grid.Row="3" Text="Gauge style" VerticalAlignment="Center" />
                                <ComboBox x:Name="GaugeBox" Grid.Row="3" Grid.Column="1" SelectionChanged="Option_Changed" Margin="0,4" />
                            </Grid>
                            <TextBlock Text="Metrics (multi-metric theme, in order)" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <UniformGrid x:Name="MetricSlots" Columns="2" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" x:Name="WidgetCard">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Add widget" Click="AddWidget_Click" />
                                <TextBlock Text="Custom layout widgets" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Drag the handles on the preview to move widgets." />
                            <ItemsControl x:Name="WidgetList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" />
                                            <ComboBox Grid.Column="1" Margin="6,0" ItemsSource="{Binding MetricChoices}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Metric}" />
                                            <TextBox Grid.Column="2" Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" ToolTip="Label (or the text for Text widgets)" />
                                            <TextBox Grid.Column="3" Margin="6,0" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" ToolTip="Size in pixels" />
                                            <Button Grid.Column="4" Content="✕" Click="RemoveWidget_Click" Tag="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Preview" Style="{StaticResource SectionTitle}" />
                            <Grid Width="320" Height="320" HorizontalAlignment="Center">
                                <Ellipse Fill="Black" />
                                <Image x:Name="PreviewImage" Width="320" Height="320">
                                    <Image.Clip><EllipseGeometry Center="160,160" RadiusX="160" RadiusY="160" /></Image.Clip>
                                </Image>
                                <Canvas x:Name="WidgetHandles" Width="320" Height="320" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
                    <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Screen" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Brightness" />
                            <DockPanel Margin="0,4,0,10">
                                <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" Text="{Binding Value, ElementName=LcdBrightness, StringFormat={}{0:0}%}" />
                                <Slider x:Name="LcdBrightness" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Option_Changed" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <TextBlock Text="Rotation" VerticalAlignment="Center" />
                                <ComboBox x:Name="RotationBox" Grid.Column="1" Margin="0,4" SelectionChanged="Option_Changed" />
                                <TextBlock Grid.Row="1" Text="Refresh" VerticalAlignment="Center" />
                                <ComboBox x:Name="RefreshBox" Grid.Row="1" Grid.Column="1" Margin="0,4" SelectionChanged="Option_Changed" />
                                <TextBlock Grid.Row="2" Text="Clock" VerticalAlignment="Center" />
                                <ComboBox x:Name="TimeBox" Grid.Row="2" Grid.Column="1" Margin="0,4" SelectionChanged="Option_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="LcdState" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Revert" Click="Revert_Click" Margin="0,0,8,0" />
                                <Button Content="Apply to LCD" Click="Apply_Click" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
        </Grid>

        <Popup x:Name="ColorPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Mouse">
            <Border Style="{StaticResource Card}" Margin="0" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" Width="320">
                <c:ColorPicker x:Name="PopupPicker" ColorChanged="PopupPicker_ColorChanged" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
