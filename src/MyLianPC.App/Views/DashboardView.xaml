<UserControl x:Class="MyLianPC.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MyLianPC.App.Controls">
    <UserControl.Resources>
        <!-- One component card: an accent dot and name, what the part is, then a label/value list. -->
        <DataTemplate x:Key="CardTemplate">
            <Border Style="{StaticResource Card}" Margin="0" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding Group}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding Spec}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Spec, Converter={StaticResource NullToVis}}" ToolTip="{Binding Spec}" />
                    <Border Height="1" Margin="0,10,0,2" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Opacity="0.6" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" Opacity="0.85"
                                                   Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Right" MaxWidth="190" ToolTip="{Binding Value}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- One cell of the connection card: what it is, its value, and a quiet note underneath. -->
        <DataTemplate x:Key="ConnectionTile">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Tooltip}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The four traffic cells: the number is what people look at, so it is set large. -->
        <DataTemplate x:Key="TrafficTile">
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8">
                <StackPanel>
                    <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Value}" FontSize="20" FontWeight="SemiBold" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Tooltip}" />
                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding Detail, Converter={StaticResource NullToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Live readings and the active hardware profile. Everything here is applied by the background service, so it keeps working when this window is closed or another Windows account is in use."
                       Style="{StaticResource PageSubtitle}" />

            <ItemsControl ItemsSource="{Binding Status.Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Banner}">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Active profile" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                    <ComboBox x:Name="ProfileBox" Grid.Column="1" DisplayMemberPath="Name" />
                    <Button Grid.Column="2" Content="Apply profile" Margin="10,0,0,0" Click="ApplyProfile_Click" />
                    <TextBlock x:Name="DeviceSummary" Grid.Column="3" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="16,0,0,0" TextAlignment="Right" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}">
                <UniformGrid Rows="1" Height="150">
                    <c:Gauge x:Name="GCpu" Label="CPU" Maximum="100" Accent="#00C2A8" Track="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Secondary="{DynamicResource TextFillColorSecondaryBrush}" />
                    <c:Gauge x:Name="GGpu" Label="GPU" Maximum="100" Accent="#7A5CFF" Track="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Secondary="{DynamicResource TextFillColorSecondaryBrush}" />
                    <c:Gauge x:Name="GCoolant" Label="Coolant" Maximum="60" Accent="#2D8CFF" Track="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Secondary="{DynamicResource TextFillColorSecondaryBrush}" />
                    <c:Gauge x:Name="GCpuLoad" Label="CPU load" Maximum="100" Accent="#E0A000" Track="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Secondary="{DynamicResource TextFillColorSecondaryBrush}" />
                    <c:Gauge x:Name="GGpuLoad" Label="GPU load" Maximum="100" Accent="#E05080" Track="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Secondary="{DynamicResource TextFillColorSecondaryBrush}" />
                    <c:Gauge x:Name="GRam" Label="Memory" Maximum="100" Accent="#40B060" Track="{DynamicResource ControlStrokeColorDefaultBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Secondary="{DynamicResource TextFillColorSecondaryBrush}" />
                </UniformGrid>
            </Border>

            <Grid Margin="0,4,0,10">
                <TextBlock Text="Metrics" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Button x:Name="CustomizeButton" Content="Customize…" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,3" Click="Customize_Click" />
            </Grid>
            <ItemsControl x:Name="Cards" ItemTemplate="{StaticResource CardTemplate}" Margin="0,0,0,12">
                <ItemsControl.ItemsPanel>
                    <!-- Every row of cards fills the width, so there is no empty block beside the last card. -->
                    <ItemsPanelTemplate><c:CardPanel MinCardWidth="230" Spacing="12" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <!-- The connection card carries the addresses, DNS and traffic totals of the whole link, so it spans the page. -->
            <Border x:Name="ConnectionCard" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="9" Height="9" CornerRadius="5" Background="#4CC2FF" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Connection" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionSpec" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    <ItemsControl x:Name="ConnectionTiles" ItemTemplate="{StaticResource ConnectionTile}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Text="Traffic" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,8" />
                    <ItemsControl x:Name="TrafficTiles" ItemTemplate="{StaticResource TrafficTile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Popup x:Name="CustomizePopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                   Placement="Bottom" PlacementTarget="{Binding ElementName=CustomizeButton}" VerticalOffset="6" HorizontalOffset="-220">
                <Border Style="{StaticResource Card}" Margin="0" Width="330"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Bottom" Content="Save" Margin="0,12,0,0" HorizontalAlignment="Right" Click="SaveMetrics_Click" />
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="Show these metrics" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All" Padding="10,2" Click="SelectAll_Click" />
                                <Button Content="None" Padding="10,2" Margin="6,0,0,0" Click="SelectNone_Click" />
                            </StackPanel>
                        </Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
                            <ItemsControl x:Name="MetricGroups">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,4">
                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding AllSelected, Mode=TwoWay}" FontWeight="SemiBold" Margin="0,6,0,2" />
                                            <ItemsControl ItemsSource="{Binding Items}" Margin="20,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Popup>

            <TextBlock Text="Temperatures" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="TempLegend" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:LineChart x:Name="TempChart" Height="190" Unit="°" TextBrush="{DynamicResource TextFillColorSecondaryBrush}" GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Utilization" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="LoadLegend" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:LineChart x:Name="LoadChart" Height="170" Unit="%" FixedMin="0" FixedMax="100" TextBrush="{DynamicResource TextFillColorSecondaryBrush}" GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </StackPanel>
            </Border>
            <TextBlock Text="Network throughput" Style="{StaticResource SectionTitle}" Margin="0,8,0,8" />
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl x:Name="NetworkLegend" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Brush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:LineChart x:Name="NetworkChart" Height="170" Unit=" MB/s" FixedMin="0" TextBrush="{DynamicResource TextFillColorSecondaryBrush}" GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
