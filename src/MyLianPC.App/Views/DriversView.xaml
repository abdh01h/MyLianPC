<UserControl x:Class="MyLianPC.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Left">
            <TextBlock Text="Drivers" Style="{StaticResource PageTitle}" />
            <TextBlock Text="BIOS and driver versions for the GIGABYTE B850 AORUS ELITE WIFI7, compared with what Windows reports as installed. Nothing is downloaded or installed unless you open a link yourself."
                       Style="{StaticResource PageSubtitle}" />

            <Border x:Name="ErrorBanner" Style="{StaticResource Banner}" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="System and BIOS" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="LastChecked" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="CheckButton" Content="Check for updates" Click="Check_Click" Padding="12,3" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Board" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock x:Name="BoardValue" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Installed BIOS" Grid.Row="1" Style="{StaticResource Caption}" Margin="0,4" />
                        <TextBlock x:Name="BiosValue" Grid.Row="1" Grid.Column="1" Margin="0,4"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="Latest on GIGABYTE" Grid.Row="2" Style="{StaticResource Caption}" Margin="0,4" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <TextBlock x:Name="LatestBios" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <Border x:Name="BiosBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="Collapsed" Padding="6,1">
                                <TextBlock x:Name="BiosBadgeText" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="BiosNotes" Style="{StaticResource Caption}" Margin="0,10,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="BiosDownload" Content="Download BIOS" Click="DownloadBios_Click" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" />
                        <Button Content="Open GIGABYTE support page" Click="Support_Click" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Drivers and utilities" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                               Text="Installed versions come from Windows: signed device drivers and installed setup packages. 'Not detected' means this PC has no matching device or program, which is normal for a package it does not need." />

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="92" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Package" Style="{StaticResource Caption}" />
                        <TextBlock Text="Installed" Grid.Column="1" Style="{StaticResource Caption}" />
                        <TextBlock Text="Latest" Grid.Column="2" Style="{StaticResource Caption}" />
                        <TextBlock Text="Status" Grid.Column="3" Style="{StaticResource Caption}" />
                    </Grid>

                    <ItemsControl x:Name="DriverList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="92" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Installed}" VerticalAlignment="Center" ToolTip="{Binding Installed}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Latest}" VerticalAlignment="Center" ToolTip="{Binding Latest}"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{Binding StateBrush}" Padding="6,1" ToolTip="{Binding Hint}">
                                        <TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Border>
                                    <Button Grid.Column="4" Content="Download" Tag="{Binding Url}" Click="Download_Click" Padding="8,2" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="EmptyDrivers" Text="No driver list yet. Check for updates to fetch it." Style="{StaticResource Caption}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Caption}"
                       Text="The list is read from GIGABYTE's public support page for this board. That request happens only when you open this page (at most once a day) or press Check, and carries no information about this PC or its usage. Links open in your browser." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
