<UserControl x:Class="MyLianPC.App.Views.LightingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MyLianPC.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel>
            <TextBlock Text="Lighting" Style="{StaticResource PageTitle}" />
            <TextBlock Text="One color or effect for everything, or each zone on its own. Only effects the selected hardware really supports are offered."
                       Style="{StaticResource PageSubtitle}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Zones -->
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <CheckBox x:Name="SyncBox" Content="Same lighting on all devices" FontWeight="SemiBold" Checked="Sync_Changed" Unchecked="Sync_Changed" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,12"
                                   Text="Turn off to give each zone its own color or effect." />
                        <ListBox x:Name="ZoneList" SelectionChanged="ZoneList_SelectionChanged" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Swatch}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Zone.Name}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Editor -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="EditorTitle" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Effect" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox x:Name="EffectBox" Grid.Column="1" SelectionChanged="Effect_Changed" />
                                <TextBlock x:Name="EffectNote" Grid.Column="2" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <c:LedPreview x:Name="Preview" Height="34" Margin="0,16,0,6" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="ColorSection">
                                    <TextBlock Text="Colors" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <ItemsControl x:Name="ColorChips">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="34" Height="34" Margin="0,0,8,0" Padding="0" Click="Chip_Click" Tag="{Binding Index}"
                                                            Background="{Binding Brush}" BorderThickness="{Binding Border}" BorderBrush="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Hex}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button x:Name="AddColorButton" Content="+" Width="34" Height="34" Click="AddColor_Click" ToolTip="Add a color" />
                                        <Button x:Name="RemoveColorButton" Content="−" Width="34" Height="34" Margin="8,0,0,0" Click="RemoveColor_Click" ToolTip="Remove selected color" />
                                    </StackPanel>
                                    <c:ColorPicker x:Name="Picker" ColorChanged="Picker_ColorChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Brightness" FontWeight="SemiBold" />
                                    <DockPanel Margin="0,4,0,14">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:0}%}" Width="44" TextAlignment="Right" />
                                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" ValueChanged="Slider_Changed" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    </DockPanel>
                                    <TextBlock Text="Speed" FontWeight="SemiBold" />
                                    <DockPanel Margin="0,4,0,14">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0:0}%}" Width="44" TextAlignment="Right" />
                                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" ValueChanged="Slider_Changed" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="All lights off" Click="Off_Click" Margin="0,0,8,0" />
                                <Button Content="Revert" Click="Revert_Click" Margin="0,0,8,0" />
                                <Button Content="Apply and save" Click="Apply_Click" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="SaveTarget" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
