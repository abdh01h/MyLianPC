<UserControl x:Class="MyLianPC.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,8,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Profiles" Style="{StaticResource PageTitle}" />
            <TextBlock Text="A profile combines lighting, LCD layout and cooling curves. Profiles are shared by every Windows account on this PC; the active one is applied at boot and kept when you switch accounts."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button Content="New" Click="New_Click" Margin="0,0,6,6" />
                        <Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,6,6" />
                        <Button Content="Rename" Click="Rename_Click" Margin="0,0,6,6" />
                        <Button Content="Delete" Click="Delete_Click" Margin="0,0,6,6" />
                        <Button Content="Import…" Click="Import_Click" Margin="0,0,6,6" />
                        <Button Content="Export…" Click="Export_Click" Margin="0,0,6,6" />
                    </WrapPanel>
                    <ListBox x:Name="List" SelectionChanged="List_SelectionChanged" BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="●" Foreground="#1F9D55" Margin="0,0,8,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Profile.Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="DetailText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Activate" Click="Activate_Click" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Re-apply active profile" Click="Reapply_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Text="To change a profile, activate it and edit it on the Lighting, Cooler LCD and Cooling pages." />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Last apply result" Style="{StaticResource SectionTitle}" />
                        <ItemsControl x:Name="LastApply">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                        <Run Text="{Binding Icon, Mode=OneWay}" /> <Run Text="{Binding Part, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
