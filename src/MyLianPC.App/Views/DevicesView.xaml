<UserControl x:Class="MyLianPC.App.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Rescan devices" Click="Rescan_Click" Margin="0,0,8,0" />
                    <Button Content="Save device settings" Click="Save_Click" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Devices" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Every component detected on this PC, how it is connected, what this app can really control on it, and what it depends on."
                               Style="{StaticResource PageSubtitle}" />
                </StackPanel>
            </DockPanel>

            <ItemsControl x:Name="DeviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Background="{Binding Status.State, Converter={StaticResource StateToBrush}}">
                                        <TextBlock Text="{Binding Status.State}" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                            <Run Text="{Binding Status.Manufacturer, Mode=OneWay}" /> <Run Text="{Binding Status.Name, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Subtitle}" />
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource Banner}" Margin="0,10,0,0" Visibility="{Binding Status.Error, Converter={StaticResource NullToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Status.Error}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding Status.Troubleshooting}" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Visibility="{Binding Status.Troubleshooting, Converter={StaticResource NullToVis}}" />
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Controls" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Status.Capabilities}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Requires" FontWeight="SemiBold" Margin="0,10,0,4" />
                                        <ItemsControl ItemsSource="{Binding Status.Dependencies}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" Style="{StaticResource Caption}" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Notes" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Status.Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding StringFormat='⚠ {0}'}" Style="{StaticResource Caption}" Margin="0,0,0,4" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Visibility="{Binding HasZones, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="Lighting zones" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Zones}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBox Width="64" Text="{Binding LedCount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Configurable}" VerticalContentAlignment="Center" />
                                                        <TextBlock Text="LEDs" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding Effects}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasFans, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="Fans" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Fans}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="110" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding RpmText}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                    <CheckBox Grid.Column="2" Content="Let MyLianPC control" IsChecked="{Binding ControlEnabled}"
                                                              Visibility="{Binding CanOptIn, Converter={StaticResource BoolToVis}}" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Note}" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
