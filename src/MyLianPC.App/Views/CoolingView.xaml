<UserControl x:Class="MyLianPC.App.Views.CoolingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MyLianPC.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,16">
        <StackPanel>
            <TextBlock Text="Cooling" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Pump and fan curves. Every curve must reach 100% by 90 °C, never goes below its minimum, and runs at 100% if its temperature sensor stops reporting."
                       Style="{StaticResource PageSubtitle}" />

            <Border Style="{StaticResource Card}">
                <UniformGrid x:Name="Readouts" Rows="1" />
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Fans and pump" Style="{StaticResource SectionTitle}" />
                        <ListBox x:Name="Targets" SelectionChanged="Targets_SelectionChanged" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="MonitorOnly" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                        <Button Content="Restore default fan behavior" Margin="0,14,0,0" Click="RestoreDefaults_Click"
                                ToolTip="Motherboard headers go back to BIOS Smart Fan; the cooler uses the Balanced curve." />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock x:Name="TargetTitle" Style="{StaticResource SectionTitle}" />
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="PresetSilent" Content="Silent" Tag="silent" Click="Preset_Click" Margin="0,0,8,8" />
                                <Button x:Name="PresetCase" Content="Case fans" Tag="case" Click="Preset_Click" Margin="0,0,8,8"
                                        ToolTip="Quiet through 38-60 °C; ramps only once the CPU is hot." />
                                <Button x:Name="PresetBalanced" Content="Balanced" Tag="balanced" Click="Preset_Click" Margin="0,0,8,8" />
                                <Button x:Name="PresetPerformance" Content="Performance" Tag="performance" Click="Preset_Click" Margin="0,0,8,8" />
                                <Button x:Name="PresetMaximum" Content="Maximum cooling" Tag="max" Click="Preset_Click" Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="PresetState" Style="{StaticResource Caption}" Margin="0,0,0,10" TextWrapping="Wrap" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="200" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Follows" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ComboBox x:Name="SourceBox" Grid.Column="1" SelectionChanged="Source_Changed" />
                                <TextBlock x:Name="SourceNow" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <c:FanCurveEditor x:Name="Editor" Height="300" Margin="0,14,0,6" CurveChanged="Editor_CurveChanged"
                                              TextBrush="{DynamicResource TextFillColorSecondaryBrush}" GridBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                              AccentBrush="{DynamicResource AccentFillColorDefaultBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="Drag points to change the curve. Double-click to add a point, right-click a point to remove it." />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="54" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                <CheckBox x:Name="FixedBox" Content="Fixed speed" Click="Fixed_Changed" VerticalAlignment="Center" />
                                <Slider x:Name="FixedSlider" Grid.Column="1" Minimum="20" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Fixed_ValueChanged" Margin="0,4" />
                                <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=FixedSlider, StringFormat={}{0:0}%}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Text="Minimum speed" VerticalAlignment="Center" />
                                <Slider x:Name="MinSlider" Grid.Row="1" Grid.Column="1" Minimum="20" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="Min_Changed" Margin="0,4" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=MinSlider, StringFormat={}{0:0}%}" TextAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="2" Text="Hysteresis" VerticalAlignment="Center" />
                                <Slider x:Name="HystSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Hyst_Changed" Margin="0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=HystSlider, StringFormat={}{0:0} °C}" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="Validation" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#C42B1C" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Revert" Click="Revert_Click" Margin="0,0,8,0" />
                                <Button x:Name="ApplyButton" Content="Apply and save" Click="Apply_Click" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                            <TextBlock x:Name="ApplyNote" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
